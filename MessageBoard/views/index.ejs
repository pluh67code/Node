<html>
  <head>
    <title>Homepage</title>
  </head>
  <body>
    <h1><%= title %></h1>
    <p><a href="/new">Post a message</a></p>
    <% for (let message of messages) { %>
        <p><%= message.username%>: <%= message.message%>
          <a href="/messages/<%= message.id%>">Open</a>
        </p>
    <% } %>
  </body>
</html>
