<html>
  <head>
    <title>Homepage</title>
  </head>
  <body>
    <h1><%= title %></h1>
    <p><a href="/new">Post a message</a></p>
    <% for (let message of messages) { %>
        <p><%= message.user%>: <%= message.text%> (<%= message.added.toLocaleString("en-US", {
                                                    weekday: "short",
                                                    hour: "numeric", 
                                                    minute: "2-digit", 
                                                    month: "short", 
                                                    day: "numeric"
                                                }
                                            ) %>)
          <a href="/messages/<%= message.id%>">Open</a>
        </p>
    <% } %>
  </body>
</html>
